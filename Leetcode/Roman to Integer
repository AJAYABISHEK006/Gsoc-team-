class Solution {
    public int romanToInt(String s) {
        int sum = 0;
        for(int i = 0; i < s.length(); i++)
        {
            if('I' == s.charAt(i) && i + 1 < s.length() && (s.charAt(i+1) == 'V' || s.charAt(i+1) == 'X'))
            {
                     if(s.charAt(i+1) == 'X')sum+= 9;
                    else if(s.charAt(i+1) == 'V')sum+= 4;
                    i++;
               
            }
            else if('X' == s.charAt(i)  && i + 1 < s.length() && (s.charAt(i+1) == 'L' || s.charAt(i+1) == 'C'))
            {
               
                     if(s.charAt(i+1) == 'L')sum+= 40;
                    else if(s.charAt(i+1) == 'C')sum+= 90;
                    i++;
            }
            else if('C' == s.charAt(i) && i + 1 < s.length() && (s.charAt(i+1) == 'D' || s.charAt(i+1) == 'M'))
            {
                
                     if(s.charAt(i+1) == 'D')sum+= 400;
                    else if(s.charAt(i+1) == 'M')sum+= 900;
                    i++;
                
            }
            else if(s.charAt(i) == 'M')sum += 1000;
            else if(s.charAt(i) == 'D')sum+= 500;
            else if(s.charAt(i) == 'C')sum+= 100;
            else if(s.charAt(i) == 'L')sum+= 50;
            else if(s.charAt(i) == 'X')sum+= 10;
            else if(s.charAt(i) == 'V')sum+= 5;
            else if(s.charAt(i) == 'I')sum+= 1;
        }
        return sum;
    }
}