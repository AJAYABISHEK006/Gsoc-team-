class Solution {
    public boolean isHappy(int n) {
        int num = n;

        while(n > 6)
        {
            int sum = 0;
            while(n > 0)
            {
            
            sum += Math.pow(n % 10,2);
            n = n / 10;
            }
            n = sum;
        }
        if(n == 1 ) return true;
        else return false;
    }
}