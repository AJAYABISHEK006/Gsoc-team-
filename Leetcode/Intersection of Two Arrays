class Solution {
    public int[] intersection(int[] nums1, int[] nums2) {
        Set<Integer> s = new HashSet<>();
        Set<Integer> n = new HashSet<>();

        for(int i =0; i < nums1.length;i++)
        {
            s.add(nums1[i]);
        }
         for(int i =0; i < nums2.length;i++)
        {
            n.add(nums2[i]);
        }
        s.retainAll(n);
        int[] arr = new int[s.size()];

            int i = 0;
            for(int x : s)
            {
                arr[i++] = x;
            }
        
        return arr;
    }
}