{
  "project": "Plastic Ledger AI Core",
  "version": "2.4.0",
  "vision": {
    "model": "SegFormer-B2-SubPixel",
    "classes": ["ABS", "Nylon", "PE", "PET", "PS", "PVC"],
    "subpixel_interpolation": "Bicubic + Active Contours",
    "magnification_scales": {
      "4x": 0.26,
      "10x": 0.65,
      "20x": 1.30,
      "40x": 2.60
