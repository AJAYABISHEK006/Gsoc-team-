      "initial_condition": 10.0,
      "boundary_condition": 5.0,
      "data_observation": 20.0
    }
  },
  "satellite": {
    "sentinel2_bands": ["B02", "B03", "B04", "B08", "B11", "B12"],
    "landsat9_bands": ["B2", "B3", "B4", "B5", "B6", "B7"],
    "indices": ["FDI", "NDVI", "Plastic_Index"]
  }
